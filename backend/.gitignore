# Bulk / row-level data: raw snapshots, interim rows, quarantine, panels. Never commit.
/data/
# run-local kernelspec written by scripts/run_data_notebooks.py
/.runner/
# independent reruns (scripts/run_data_notebooks.py --output-dir ...) kept inside backend by convention
/rerun*/
.ipynb_checkpoints/
.pytest_cache/
__pycache__/
# reports/data/ is tracked on purpose: only small aggregated JSON/CSV/PNG evidence is written there.
# Guard against row-level files being dropped into reports by mistake:
/reports/data/**/*row*.csv
/reports/data/**/*events*.csv
/reports/data/**/*panel*.csv
/reports/data/**/*quarantine*.csv
# Model stage: row-level OOF predictions and fitted bundles live under /data/model/ (ignored above).
# reports/models/ keeps only aggregated metrics/locks/manifests; guard against row-level files or bundles there.
/reports/models/**/*predictions*.csv
/reports/models/**/*panel*.csv
*.joblib
# staging copy used only for a tooling handoff of notebook 06
/notebooks/*.ipynb.continuation
